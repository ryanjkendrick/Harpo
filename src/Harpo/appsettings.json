{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Harpo": "Data Source=harpo.db"
  },
  "Harpo": {
    "SiteId": "default",
    "MasterKey": "",
    "DatabaseKey": "",
    "DataProtectionKeysPath": "",
    "Offline": {
      "Enabled": true,
      "SnapshotMaxAgeDays": 7
    }
  },
  "Auth": {
    "Mode": "Ldap",
    "Ldap": {
      "Server": "",
      "Port": 636,
      "UseSsl": true,
      "SkipCertificateValidation": false,
      "UpnSuffix": "",
      "SearchBase": "",
      "AdminGroup": "Harpo Admins",
      "TimeoutSeconds": 10
    }
  },
  "Replication": {
    "Key": "",
    "IntervalSeconds": 15,
    "BatchSize": 2000,
    "Peers": []
  }
}
