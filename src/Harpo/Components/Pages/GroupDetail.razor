@page "/groups/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject GroupService Groups
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(_group?.Name ?? "Group") · Harpo</PageTitle>
<SessionWatch />

<div class="page-narrow">
    @if (_loadError is not null)
    {
        <div class="alert alert-error">@_loadError</div>
        <p class="gap-top"><a class="btn btn-primary" href="/groups">Back to groups</a></p>
    }
    else if (_group is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="page-header">
            <h1>@_group.Name</h1>
            <a class="btn btn-ghost" href="/vault/@_group.Id">Open in vault →</a>
        </div>
        @if (!string.IsNullOrEmpty(_group.Description))
        {
            <p class="muted">@_group.Description</p>
        }

        @if (_group.IsPersonal)
        {
            <section class="panel">
                <h2>Your personal vault</h2>
                <p class="muted">
                    This is not a group: it has no members, no settings, and cannot be deleted.
                    Only you can see what is in it — site administrators included. Should you
                    leave, an administrator can turn it into an ordinary group so that company
                    accounts kept here are not lost; that is recorded in the audit log, and if
                    you are still around you would see the change in your vault.
                </p>
            </section>
        }

        @if (CanAdmin)
        {
            <section class="panel">
                <h2>Group settings</h2>
                <div class="form-row">
                    <label class="field">
                        <span class="field-label">Name</span>
                        <input @bind="_editName" />
                    </label>
                    <label class="field field-grow">
                        <span class="field-label">Description</span>
                        <input @bind="_editDescription" />
                    </label>
                    <button class="btn btn-primary" @onclick="SaveGroupAsync">Save</button>
                </div>
            </section>
        }

        @if (!_group.IsPersonal)
        {
        <section class="panel">
            <h2>Members</h2>
            <p class="muted">Only these people and the site administrators can see the passwords in this group.</p>
            @if (_members is { Count: > 0 } && _members.All(m => m.Role != GroupRole.Admin))
            {
                <div class="alert alert-warning">
                    <strong>This group has no admin.</strong> That can happen when admins on two sites change
                    each other's roles at the same moment. Members keep their access, but only a site
                    administrator can manage the group until one of them appoints a new admin.
                </div>
            }
            @if (_members is not null)
            {
                <div class="table-scroll">
                    <table class="members-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th>Added by</th>
                                @if (CanAdmin)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in _members)
                            {
                                <tr>
                                    <td>
                                        <span class="mono">@member.Username</span>
                                        @if (!string.IsNullOrEmpty(member.DisplayName) && member.DisplayName != member.Username)
                                        {
                                            <span class="muted"> · @member.DisplayName</span>
                                        }
                                        @if (member.Verified == false)
                                        {
                                            @* Only a membership made while the directory could not be
                                               asked. Null (from before Harpo asked) is not flagged. *@
                                            <span class="badge badge-unverified" title="@UnverifiedTitle">unverified</span>
                                        }
                                    </td>
                                    <td>
                                        @if (CanAdmin)
                                        {
                                            <select value="@member.Role" @onchange="e => ChangeRoleAsync(member, e)">
                                                <option value="@GroupRole.Viewer">Viewer</option>
                                                <option value="@GroupRole.Member">Member</option>
                                                <option value="@GroupRole.Admin">Admin</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="badge @(member.Role == GroupRole.Admin ? "badge-admin" : "")">
                                                @member.Role.ToString().ToLowerInvariant()
                                            </span>
                                        }
                                    </td>
                                    <td class="muted">@member.AddedBy</td>
                                    @if (CanAdmin)
                                    {
                                        <td class="cell-actions">
                                            <button class="btn btn-icon" title="Remove from group" aria-label="Remove from group"
                                                    @onclick="() => RemoveMemberAsync(member)"><Lucide Name="trash" Size="16" /></button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (CanAdmin)
                {
                    <div class="form-row add-member-row">
                        <div class="field">
                            <label class="field-label" for="new-member-username">AD username</label>
                            <div class="member-picker">
                                <input id="new-member-username" @ref="_usernameInput" autocomplete="off" spellcheck="false"
                                       @bind="_newMemberUsername" @bind:event="oninput" @bind:after="OnUsernameInputAsync"
                                       @onkeydown="OnUsernameKeyDownAsync"
                                       aria-describedby="member-suggestion-status" placeholder="e.g. jsmith" />
                                @if (_suggestions.Count > 0)
                                {
                                    <ul class="member-suggestions" aria-label="Directory accounts" @onkeydown="OnSuggestionKeyDownAsync">
                                        @for (var i = 0; i < _suggestions.Count; i++)
                                        {
                                            var account = _suggestions[i];
                                            var first = i == 0;
                                            <li>
                                                @* Only the first one needs a reference: ArrowDown in the field moves there. *@
                                                @if (first)
                                                {
                                                    <button type="button" class="member-suggestion" @ref="_firstSuggestion"
                                                            @onclick="() => PickSuggestion(account)">@SuggestionContent(account)</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="member-suggestion"
                                                            @onclick="() => PickSuggestion(account)">@SuggestionContent(account)</button>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            <span id="member-suggestion-status" class="visually-hidden" role="status">@_suggestionStatus</span>
                        </div>
                        <label class="field">
                            <span class="field-label">@(_picked is null ? "Display name (optional)" : "Display name (from the directory)")</span>
                            <input @bind="_newMemberDisplayName" readonly="@(_picked is not null)" @onfocus="() => CancelSearch()" />
                        </label>
                        <label class="field">
                            <span class="field-label">Role</span>
                            <select @bind="_newMemberRole" @onfocus="() => CancelSearch()">
                                <option value="@GroupRole.Viewer">Viewer</option>
                                <option value="@GroupRole.Member">Member</option>
                                <option value="@GroupRole.Admin">Admin</option>
                            </select>
                        </label>
                        <button class="btn btn-primary" @onclick="AddMemberAsync">Add member</button>
                    </div>
                    @if (_directoryUnavailable)
                    {
                        <p class="muted form-hint directory-note">
                            The directory cannot be asked (no service account configured, or it is unreachable);
                            the account name will be stored as typed.
                        </p>
                    }
                    <p class="muted form-hint">
                        The username must match the account name the person signs in with
                        (their AD <span class="mono">sAMAccountName</span>)@(_directoryUnavailable ? "." : "; Harpo looks it up in the directory and keeps the directory's display name.")
                        <strong>Viewers</strong> can see and copy passwords but change nothing;
                        <strong>members</strong> can also add and edit them; <strong>admins</strong>
                        additionally manage this group and its members.
                    </p>
                }
            }
        </section>
        }

        @if (_error is not null)
        {
            <div class="alert alert-error">@_error</div>
        }

        @if (CanAdmin)
        {
            <section class="panel panel-danger">
                <h2>Danger zone</h2>
                <p class="muted">
                    Deleting a group hides it and its passwords on every site.
                    Password history is retained in the database.
                </p>
                <button class="btn btn-danger" @onclick="DeleteGroupAsync">Delete this group</button>
            </section>
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private UserContext? _user;
    private Group? _group;
    private GroupRole? _myRole;
    private List<GroupMember>? _members;
    private string _editName = "";
    private string _editDescription = "";
    private string _newMemberUsername = "";
    private string _newMemberDisplayName = "";
    private GroupRole _newMemberRole = GroupRole.Member;
    private string? _error;
    private string? _loadError;

    // ---- directory suggestions for the add-member field ----
    private const int MinSearchLength = 2;
    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(250);
    private const string UnverifiedTitle =
        "Not checked against the directory: added while the directory could not be asked. " +
        "The account name and display name are as they were typed.";

    private ElementReference _usernameInput;
    private ElementReference _firstSuggestion;
    private IReadOnlyList<DirectoryAccount> _suggestions = [];
    private string _suggestionStatus = "";
    /// <summary>The suggestion chosen, while the field still holds its name: the display name is then the directory's.</summary>
    private DirectoryAccount? _picked;
    private bool _directoryUnavailable;
    private CancellationTokenSource? _searchCancel;
    /// <summary>Bumped by every keystroke (and by adding): an answer for an older number is stale and dropped.</summary>
    private int _searchGeneration;

    private bool CanAdmin =>
        _user is not null && _group?.IsPersonal != true && (_user.IsSiteAdmin || _myRole == GroupRole.Admin);

    protected override async Task OnInitializedAsync()
    {
        _user = UserContext.FromPrincipal((await AuthState).User);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var (group, role) = await Groups.GetGroupAsync(_user!, Id);
            _group = group;
            _myRole = role;
            _editName = group.Name;
            _editDescription = group.Description;
            _members = await Groups.GetMembersAsync(_user!, Id);
        }
        catch (Exception ex) when (ex is VaultAccessDeniedException or VaultNotFoundException)
        {
            _loadError = ex.Message;
        }
    }

    private async Task SaveGroupAsync()
    {
        await Guarded(async () =>
        {
            await Groups.UpdateGroupAsync(_user!, Id, _editName, _editDescription);
            await LoadAsync();
        });
    }

    private async Task AddMemberAsync()
    {
        CancelSearch();
        await Guarded(async () =>
        {
            var added = await Groups.AddMemberAsync(_user!, Id, _newMemberUsername, _newMemberDisplayName, _newMemberRole);
            // An unverified add means the directory could not be asked just now;
            // say so even if no search ran first (a pasted name, a quick typist).
            _directoryUnavailable = !added.Verified;
            _newMemberUsername = "";
            _newMemberDisplayName = "";
            _newMemberRole = GroupRole.Member;
            _picked = null;
            await LoadAsync();
        });
    }

    /// <summary>
    /// Every keystroke in the username field: forget a chosen suggestion the
    /// text no longer matches, then — after a pause in typing — ask the
    /// directory for accounts like it. Each keystroke starts a new generation;
    /// an answer that arrives for an older one is ignored, so a slow reply
    /// never replaces the suggestions for what is in the field now.
    /// </summary>
    private async Task OnUsernameInputAsync()
    {
        var term = _newMemberUsername.Trim();
        if (_picked is not null && !string.Equals(_picked.Username, term, StringComparison.OrdinalIgnoreCase))
        {
            _picked = null;
            _newMemberDisplayName = "";
        }

        // The suggestions on screen stay until the new answer replaces them, so
        // the list does not flicker shut at every keystroke.
        CancelSearch(close: false);
        var generation = _searchGeneration;
        if (term.Length < MinSearchLength || _picked is not null)
        {
            CloseSuggestions();
            return;
        }

        var cancel = _searchCancel = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDebounce, cancel.Token);
            var result = await Groups.SearchAccountsAsync(_user!, Id, term, cancel.Token);
            if (generation != _searchGeneration)
            {
                return;
            }
            _directoryUnavailable = !result.Available;
            _suggestions = result.Accounts;
            _suggestionStatus = !result.Available ? ""
                : result.Accounts.Count == 0 ? "No matching accounts in the directory."
                : result.Accounts.Count == 1 ? "1 matching account. Press Down or Tab to reach it."
                : $"{result.Accounts.Count} matching accounts. Press Down or Tab to reach them.";
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke took over.
        }
        catch (Exception ex) when (ex is VaultAccessDeniedException or VaultNotFoundException)
        {
            if (generation == _searchGeneration)
            {
                _error = ex.Message;
            }
        }
    }

    /// <summary>Drops pending and shown suggestions; any answer still on its way is stale.</summary>
    private void CancelSearch(bool close = true)
    {
        _searchGeneration++;
        _searchCancel?.Cancel();
        _searchCancel = null;
        if (close)
        {
            CloseSuggestions();
        }
    }

    private void CloseSuggestions()
    {
        _suggestions = [];
        _suggestionStatus = "";
    }

    private void PickSuggestion(DirectoryAccount account)
    {
        CancelSearch();
        _picked = account;
        _newMemberUsername = account.Username;
        _newMemberDisplayName = account.DisplayName;
        _suggestionStatus = account.Disabled
            ? $"{account.Username} is disabled in the directory."
            : $"{account.Username} chosen: {account.DisplayName}.";
    }

    private async Task OnUsernameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown" && _suggestions.Count > 0)
        {
            await _firstSuggestion.FocusAsync();
        }
        else if (e.Key == "Escape")
        {
            CancelSearch();
        }
    }

    private async Task OnSuggestionKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelSearch();
            await _usernameInput.FocusAsync();
        }
    }

    private static RenderFragment SuggestionContent(DirectoryAccount account) =>
        @<text>
            <span class="mono">@account.Username</span>
            <span class="muted">· @account.DisplayName</span>
            @if (account.Disabled)
            {
                <span class="badge badge-error">disabled</span>
            }
        </text>;

    public void Dispose()
    {
        _searchCancel?.Cancel();
    }

    private async Task ChangeRoleAsync(GroupMember member, ChangeEventArgs e)
    {
        if (!Enum.TryParse<GroupRole>(e.Value?.ToString(), out var role))
        {
            return;
        }
        await Guarded(async () =>
        {
            await Groups.SetMemberRoleAsync(_user!, Id, member.Username, role);
            await LoadAsync();
        });
    }

    private async Task RemoveMemberAsync(GroupMember member)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Remove {member.DisplayName} ({member.Username}) from this group? They lose access to its passwords immediately.");
        if (!confirmed)
        {
            return;
        }
        await Guarded(async () =>
        {
            await Groups.RemoveMemberAsync(_user!, Id, member.Username);
            await LoadAsync();
        });
    }

    private async Task DeleteGroupAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete the group \"{_group?.Name}\" and hide all of its passwords on every site? " +
            "Only a site administrator can restore it (Administration → Deleted groups).");
        if (!confirmed)
        {
            return;
        }
        await Guarded(async () =>
        {
            await Groups.DeleteGroupAsync(_user!, Id);
            Navigation.NavigateTo("/groups");
        });
    }

    private async Task Guarded(Func<Task> action)
    {
        try
        {
            _error = null;
            await action();
        }
        catch (Exception ex) when (ex is VaultValidationException or VaultAccessDeniedException or VaultNotFoundException)
        {
            _error = ex.Message;
        }
    }
}
