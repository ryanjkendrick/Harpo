    private bool _showAllDeletedGroups;
    private List<IconSummary>? _icons;
    private Dictionary<Guid, int> _iconUsage = new();
    private readonly Dictionary<Guid, string> _iconUrlEdits = new();
    private readonly Dictionary<Guid, string> _iconNameEdits = new();
    private string? _importResult;
    private string? _iconError;
    private string _newIconName = "";
    private string _newIconUrls = "";
    private byte[]? _stagedIconData;
    private string _stagedIconType = "";

    private bool IconRowDirty(IconSummary icon) =>
        _iconNameEdits.GetValueOrDefault(icon.Id, icon.Name) != icon.Name
        || _iconUrlEdits.GetValueOrDefault(icon.Id, icon.MatchUrls) != icon.MatchUrls;

    private async Task StageIconAsync(InputFileChangeEventArgs e)
    {
        _iconError = null;
        try
        {
            var file = e.File;
            if (file.Size > CustomIcon.MaxBytes)
            {
                _iconError = $"Icons are capped at {CustomIcon.MaxBytes / 1024} KB — resize the image first.";
                _stagedIconData = null;
                return;
            }
            await using var stream = file.OpenReadStream(CustomIcon.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _stagedIconData = buffer.ToArray();
            _stagedIconType = file.ContentType;
            if (string.IsNullOrWhiteSpace(_newIconName))
            {
                _newIconName = Path.GetFileNameWithoutExtension(file.Name);
            }
        }
        catch (Exception)
        {
            _iconError = "Could not read that file — try a different image.";
            _stagedIconData = null;
        }
    }

    private async Task AddIconAsync()
    {
        if (_stagedIconData is null)
        {
            return;
        }
        try
        {
            _iconError = null;
            await Icons.AddAsync(_user!, _newIconName, _stagedIconType, _stagedIconData, _newIconUrls);
            _stagedIconData = null;
            _newIconName = "";
            _newIconUrls = "";
            await RefreshIconsAsync();
        }
        catch (VaultValidationException ex)
        {
            _iconError = ex.Message;
        }
    }

    private async Task SaveIconAsync(IconSummary icon)
    {
        try
        {
            _iconError = null;
            await Icons.UpdateAsync(_user!, icon.Id,
                name: _iconNameEdits.GetValueOrDefault(icon.Id, icon.Name),
                matchUrls: _iconUrlEdits.GetValueOrDefault(icon.Id, icon.MatchUrls));
            _iconNameEdits.Remove(icon.Id);
            _iconUrlEdits.Remove(icon.Id);
            await RefreshIconsAsync();
        }
        catch (Exception ex) when (ex is VaultValidationException or VaultAccessDeniedException)
        {
            _iconError = ex.Message;
        }
    }

    private async Task RefreshIconsAsync()
    {
        _icons = await Icons.GetAllAsync();
        _iconUsage = await Icons.GetUsageAsync();
        await LoadAuditAsync();
    }
    private int _auditPage = 1;
    private int _auditTotal;
    /// <summary>Bumped by every load: an answer for an older load (a slower query for an earlier keystroke) is dropped.</summary>
    private int _auditLoads;
    private string _auditFilter = "";
    private AuditCategory _auditCategory = AuditCategory.All;

    private static readonly (AuditCategory Category, string Label, string Hint)[] AuditCategoryChips =
    [
        (AuditCategory.All, "All", "Every recorded event"),
        (AuditCategory.Reveals, "Reveals", "Passwords and 2FA codes shown or copied, vaults and all groups exported"),
        (AuditCategory.Changes, "Changes", "Memberships, roles, restores, icons, key rotation, personal-vault takeovers"),
        (AuditCategory.Deletions, "Deletions", "Passwords, groups, members and icons removed"),
        (AuditCategory.Background, "Background", "Routine activity: offline syncs, health report views"),
    ];

    /// <summary>One line of the table: an event, plus how many identical ones directly preceded it.</summary>
    private sealed record AuditRow(AuditEvent Latest, int Count, DateTime OldestUtc);

    /// <summary>
    /// Folds a run of the same person doing the same thing to the same object into
    /// one row ("×4"), so a device syncing every few minutes or a page opened
    /// repeatedly doesn't push everything else off the screen. Runs fold within
    /// the page shown; one that spans two pages appears on both.
    /// </summary>
    private List<AuditRow> AuditRows
    {
        get
        {
            var rows = new List<AuditRow>();
            foreach (var e in _auditEvents ?? [])
            {
                if (rows.Count > 0 && rows[^1].Latest is var previous
                    && previous.Action == e.Action && previous.Username == e.Username
                    && previous.Target == e.Target && previous.OriginSiteId == e.OriginSiteId)
                {
                    rows[^1] = rows[^1] with { Count = rows[^1].Count + 1, OldestUtc = e.OccurredAtUtc };
                }
                else
                {
                    rows.Add(new AuditRow(e, 1, e.OccurredAtUtc));
                }
            }
            return rows;
        }
    }

    private static string AuditWhenTitle(AuditRow row) =>
        row.Count == 1
            ? $"{row.Latest.OccurredAtUtc:yyyy-MM-dd HH:mm:ss} UTC"
            : $"{row.Count} times, from {row.OldestUtc:yyyy-MM-dd HH:mm:ss} to {row.Latest.OccurredAtUtc:yyyy-MM-dd HH:mm:ss} UTC";

    /// <summary>
    /// Loads the page shown, filtered by category and search in the query, so
    /// both reach every event and not just the ones already on screen.
    /// </summary>
    private async Task LoadAuditAsync()
    {
        var load = ++_auditLoads;
        var page = await Audit.GetEventPageAsync(_user!, _auditCategory, _auditFilter, _auditPage, AuditPageSize);
        if (load != _auditLoads)
        {
            return;
        }
        _auditEvents = page.Items;
        _auditTotal = page.Total;
        _auditPage = page.Page;
    }

    private async Task SetAuditCategoryAsync(AuditCategory category)
    {
        _auditCategory = category;
        _auditPage = 1;
        await LoadAuditAsync();
    }

    private async Task OnAuditFilterTypedAsync()
    {
        _auditPage = 1;

        // Each load scans the trail, so wait for a pause in the typing.
        _auditFilterCts?.Cancel();
        _auditFilterCts?.Dispose();
        var cts = _auditFilterCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(AuditFilterDebounce, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // another keystroke, or the page closed
        }
        await LoadAuditAsync();
    }

    private async Task GoToAuditPageAsync(int page)
    {
        _auditPage = page;
        await LoadAuditAsync();
    }
    private Timer? _refreshTimer;

    private const int AuditPageSize = 50;
    private static readonly TimeSpan AuditFilterDebounce = TimeSpan.FromMilliseconds(250);
    private CancellationTokenSource? _auditFilterCts;

    private static string AuditBadgeClass(string action) => action switch
    {
        _ when AuditActions.CategoryOf(action) == AuditCategory.Reveals => "badge-admin",
        _ when AuditActions.CategoryOf(action) == AuditCategory.Deletions => "badge-error",
        _ => "",
    };

    private IReadOnlyList<PeerSyncStatus> PeerStatuses =>
        ReplicationConfig.Value.Peers
            .Select(p => Tracker.GetOrAdd(p.Name, p.Url))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _user = UserContext.FromPrincipal((await AuthState).User);
        _groups = await Groups.GetMyGroupsAsync(_user);
        _status = await Engine.GetStatusAsync();
        await LoadAuditAsync();
        await LoadDeletedGroupsAsync();
        _adminlessGroups = await Groups.GetGroupsWithoutAdminAsync(_user);
        _personalVaults = await Groups.GetPersonalVaultsAsync(_user);
        _icons = await Icons.GetAllAsync();
        _iconUsage = await Icons.GetUsageAsync();
        _refreshTimer = new Timer(_ => _ = RefreshAsync(), null,
            TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshAsync()
    {
        try
        {
            var status = await Engine.GetStatusAsync();
            await InvokeAsync(() =>
            {
                _status = status;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task ImportIconsAsync()
    {
        var imported = await Icons.ImportFromDirectoryAsync();
        _importResult = imported == 0 ? "nothing new" : $"imported {imported}";
        await RefreshIconsAsync();
    }

    private async Task DeleteIconAsync(IconSummary icon)
    {
        await Icons.DeleteAsync(_user!, icon.Id);
        await RefreshIconsAsync();
    }

    private async Task LoadDeletedGroupsAsync()
    {
        var page = await Groups.GetDeletedGroupsAsync(_user!);
        _deletedGroups = page.Items;
        _deletedGroupsTotal = page.Total;
    }

    /// <summary>Appends the next page; the cursor is the last group shown, so ties are not skipped.</summary>
    private async Task LoadOlderDeletedGroupsAsync()
    {
        if (_deletedGroups is not { Count: > 0 })
        {
            return;
        }
        var last = _deletedGroups[^1];
        var page = await Groups.GetDeletedGroupsAsync(_user!, new DeletedCursor(last.UpdatedAtUtc, last.Id));
        _deletedGroups.AddRange(page.Items);
        _deletedGroupsTotal = page.Total;
    }

    private Group? _purgeGroup;
    private bool _purgeGroupBusy;
    private string? _purgeGroupError;
    private string? _purgedGroupMessage;

    private void OpenPurgeGroup(Group group)
    {
        _purgeGroup = group;
        _purgeGroupError = null;
        _purgedGroupMessage = null;
    }

    private void ClosePurgeGroup()
    {
        if (!_purgeGroupBusy)
        {
            _purgeGroup = null;
        }
    }

    private async Task PurgeGroupAsync()
    {
        if (_purgeGroup is not { } group || _purgeGroupBusy)
        {
            return;
        }
        _purgeGroupBusy = true;
        _purgeGroupError = null;
        StateHasChanged();
        await Task.Yield();
        var user = _user!;
        try
        {
            var purged = await Task.Run(() => Purge.PurgeGroupAsync(user, group.Id));
            _purgedGroupMessage = $"Purged {group.Name} ({(purged == 1 ? "1 password" : $"{purged:N0} passwords")}).";
            _purgeGroup = null;
        }
        catch (Exception ex) when (ex is VaultValidationException or VaultAccessDeniedException or VaultNotFoundException)
        {
            _purgeGroupError = ex.Message;
        }
        finally
        {
            _purgeGroupBusy = false;
        }
        await LoadDeletedGroupsAsync();
        await LoadAuditAsync();
    }

    private async Task RestoreGroupAsync(Group group)
    {
        await Groups.RestoreGroupAsync(_user!, group.Id);
        _groups = await Groups.GetMyGroupsAsync(_user!);
        await LoadDeletedGroupsAsync();
        await LoadAuditAsync();
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        _auditFilterCts?.Cancel();
        _auditFilterCts?.Dispose();
    }

    private static string FormatSkew(TimeSpan skew) =>
        skew.TotalSeconds < 10 ? $"{skew.TotalSeconds:0.0}s"
        : skew.TotalMinutes < 2 ? $"{skew.TotalSeconds:0}s"
        : $"{skew.TotalMinutes:0}m";

    private static string Relative(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        return span.TotalSeconds < 5 ? "just now"
            : span.TotalSeconds < 90 ? $"{Math.Round(span.TotalSeconds)}s ago"
            : span.TotalMinutes < 90 ? $"{Math.Round(span.TotalMinutes)}m ago"
            : $"{Math.Round(span.TotalHours)}h ago";
    }
