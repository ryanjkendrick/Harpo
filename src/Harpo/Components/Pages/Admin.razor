@page "/admin"
@attribute [Authorize(Roles = HarpoClaims.SiteAdminRole)]
@rendermode InteractiveServer
@using Harpo.Replication
@using Microsoft.Extensions.Options
@inject ReplicationEngine Engine
@inject ReplicationStatusTracker Tracker
@inject IOptions<ReplicationOptions> ReplicationConfig
@inject IOptions<Harpo.Offline.OfflineOptions> OfflineConfig
@inject GroupService Groups
@inject AuditService Audit
@implements IDisposable

<PageTitle>Administration · Harpo</PageTitle>

<div class="page-narrow">
    <h1>Administration</h1>

    <section class="panel">
        <h2>This site</h2>
        <div class="stat-row">
            <div class="stat">
                <span class="stat-value mono">@Engine.SiteId</span>
                <span class="stat-label">site id</span>
            </div>
            <div class="stat">
                <span class="stat-value">@(_status?.Groups.ToString() ?? "…")</span>
                <span class="stat-label">groups</span>
            </div>
            <div class="stat">
                <span class="stat-value">@(_status?.Entries.ToString() ?? "…")</span>
                <span class="stat-label">passwords</span>
            </div>
            <div class="stat" title="Set Harpo__Offline__Enabled=false to forbid offline password storage on devices.">
                <span class="stat-value">@(OfflineConfig.Value.Enabled ? $"on · {OfflineConfig.Value.SnapshotMaxAgeDays}d" : "off")</span>
                <span class="stat-label">offline access</span>
            </div>
        </div>
    </section>

    <section class="panel">
        <h2>Cross-site replication</h2>
        @if (!ReplicationConfig.Value.Enabled)
        {
            <p class="muted">
                Replication is disabled — set <span class="mono">Replication:Key</span> and
                <span class="mono">Replication:Peers</span> to connect this site to others.
            </p>
        }
        else if (ReplicationConfig.Value.Peers.Count == 0)
        {
            <p class="muted">
                A replication key is set, so other sites can pull from this one, but this
                site has no peers of its own configured.
            </p>
        }
        else
        {
            <div class="table-scroll">
                <table class="peers-table">
                    <thead>
                        <tr><th>Peer</th><th>URL</th><th>Last sync</th><th>Rows pulled</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var peer in PeerStatuses)
                        {
                            <tr>
                                <td class="mono">@peer.Name</td>
                                <td class="mono muted">@peer.Url</td>
                                <td title="@(peer.LastSuccessUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")">
                                    @(peer.LastSuccessUtc is null ? "never" : Relative(peer.LastSuccessUtc.Value))
                                </td>
                                <td>@peer.TotalPulledRows</td>
                                <td>
                                    @if (peer.LastError is not null)
                                    {
                                        <span class="badge badge-error" title="@peer.LastError">error</span>
                                    }
                                    else if (peer.LastSuccessUtc is not null)
                                    {
                                        <span class="badge badge-ok">healthy</span>
                                    }
                                    else
                                    {
                                        <span class="badge">waiting</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_status is not null && _status.Vector.Count > 0)
        {
            <h3>High-watermark vector</h3>
            <p class="muted">
                Highest change sequence this site has seen from each origin — replication
                is caught up when peers report the same numbers.
            </p>
            <div class="vector">
                @foreach (var (site, seq) in _status.Vector.OrderBy(kv => kv.Key, StringComparer.Ordinal))
                {
                    <span class="vector-chip mono">@site → @seq</span>
                }
            </div>
        }
    </section>

    <section class="panel">
        <h2>Audit log</h2>
        <p class="muted">
            Who revealed, copied, or deleted what — recorded
            @(Audit.Enabled ? "on this site" : "on other sites only") and replicated everywhere.
            @if (!Audit.Enabled)
            {
                <span class="badge badge-error" title="Set Harpo__Audit__Enabled=true to record events on this site.">recording off</span>
            }
            else
            {
                <span class="badge badge-ok" title="Set Harpo__Audit__Enabled=false to stop recording on this site.">recording on</span>
                <span class="badge">@(Audit.RetentionDays > 0 ? $"kept {Audit.RetentionDays}d" : "kept forever")</span>
            }
        </p>

        @if (_auditEvents is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_auditEvents.Count == 0)
        {
            <p class="muted">No audit events yet.</p>
        }
        else
        {
            <input class="search" type="search" placeholder="Filter by user, action, or target…"
                   @bind="_auditFilter" @bind:event="oninput" />
            <div class="table-scroll">
                <table class="audit-table">
                    <thead>
                        <tr><th>When</th><th>Who</th><th>Action</th><th>What</th><th>Site</th><th>From</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in FilteredAudit)
                        {
                            <tr>
                                <td title="@($"{e.OccurredAtUtc:yyyy-MM-dd HH:mm:ss} UTC")">@Relative(e.OccurredAtUtc)</td>
                                <td class="mono">@e.Username</td>
                                <td><span class="badge @AuditBadgeClass(e.Action)">@e.Action</span></td>
                                <td>
                                    @e.Target
                                    @if (!string.IsNullOrEmpty(e.Detail))
                                    {
                                        <span class="muted"> · @e.Detail</span>
                                    }
                                </td>
                                <td class="mono muted">@e.OriginSiteId</td>
                                <td class="mono muted">@e.ClientAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_auditHasMore)
            {
                <button class="btn btn-ghost btn-sm" @onclick="LoadMoreAuditAsync">Load older events</button>
            }
        }
    </section>

    @if (_deletedGroups is { Count: > 0 })
    {
        <section class="panel">
            <h2>Deleted groups</h2>
            <p class="muted">Restoring a group brings back the passwords that were not deleted individually.</p>
            <div class="card-list">
                @foreach (var g in _deletedGroups)
                {
                    <div class="card group-card">
                        <div class="group-card-main">
                            <span class="group-card-name">@g.Name</span>
                            <span class="muted">deleted @Relative(g.UpdatedAtUtc)</span>
                        </div>
                        <div class="group-card-meta">
                            <button class="btn btn-ghost btn-sm" @onclick="() => RestoreGroupAsync(g)">Restore</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="panel">
        <h2>All groups</h2>
        @if (_groups is null)
        {
            <p class="muted">Loading…</p>
        }
        else
        {
            <div class="card-list">
                @foreach (var g in _groups)
                {
                    <a class="card group-card" href="/groups/@g.Group.Id">
                        <div class="group-card-main">
                            <span class="group-card-name">@g.Group.Name</span>
                            <span class="muted">created by @g.Group.CreatedBy</span>
                        </div>
                        <div class="group-card-meta">
                            <span>@g.MemberCount members</span>
                            <span>@g.EntryCount passwords</span>
                        </div>
                    </a>
                }
            </div>
        }
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private UserContext? _user;
    private ReplicationStatusResponse? _status;
    private List<GroupSummary>? _groups;
    private List<AuditEvent>? _auditEvents;
    private List<Group>? _deletedGroups;
    private bool _auditHasMore;
    private string _auditFilter = "";
    private Timer? _refreshTimer;

    private const int AuditPageSize = 50;

    private IEnumerable<AuditEvent> FilteredAudit
    {
        get
        {
            if (_auditEvents is null)
            {
                return [];
            }
            var term = _auditFilter.Trim();
            if (term.Length == 0)
            {
                return _auditEvents;
            }
            return _auditEvents.Where(e =>
                e.Username.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Action.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Target.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Detail.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static string AuditBadgeClass(string action) => action switch
    {
        AuditActions.PasswordReveal or AuditActions.PasswordCopy or AuditActions.RevisionReveal => "badge-admin",
        AuditActions.EntryDelete or AuditActions.GroupDelete or AuditActions.MemberRemove => "badge-error",
        _ => "",
    };

    private async Task LoadMoreAuditAsync()
    {
        if (_auditEvents is null || _auditEvents.Count == 0)
        {
            return;
        }
        var oldest = _auditEvents[^1].OccurredAtUtc;
        var more = await Audit.GetEventsAsync(_user!, beforeUtc: oldest, take: AuditPageSize);
        _auditEvents.AddRange(more);
        _auditHasMore = more.Count == AuditPageSize;
    }

    private IReadOnlyList<PeerSyncStatus> PeerStatuses =>
        ReplicationConfig.Value.Peers
            .Select(p => Tracker.GetOrAdd(p.Name, p.Url))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _user = UserContext.FromPrincipal((await AuthState).User);
        _groups = await Groups.GetMyGroupsAsync(_user);
        _status = await Engine.GetStatusAsync();
        _auditEvents = await Audit.GetEventsAsync(_user, take: AuditPageSize);
        _auditHasMore = _auditEvents.Count == AuditPageSize;
        _deletedGroups = await Groups.GetDeletedGroupsAsync(_user);
        _refreshTimer = new Timer(_ => _ = RefreshAsync(), null,
            TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshAsync()
    {
        try
        {
            var status = await Engine.GetStatusAsync();
            await InvokeAsync(() =>
            {
                _status = status;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RestoreGroupAsync(Group group)
    {
        await Groups.RestoreGroupAsync(_user!, group.Id);
        _groups = await Groups.GetMyGroupsAsync(_user!);
        _deletedGroups = await Groups.GetDeletedGroupsAsync(_user!);
        _auditEvents = await Audit.GetEventsAsync(_user!, take: AuditPageSize);
    }

    public void Dispose() => _refreshTimer?.Dispose();

    private static string Relative(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        return span.TotalSeconds < 5 ? "just now"
            : span.TotalSeconds < 90 ? $"{Math.Round(span.TotalSeconds)}s ago"
            : span.TotalMinutes < 90 ? $"{Math.Round(span.TotalMinutes)}m ago"
            : $"{Math.Round(span.TotalHours)}h ago";
    }
}
