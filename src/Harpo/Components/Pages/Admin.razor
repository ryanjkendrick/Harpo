@page "/admin"
@attribute [Authorize(Roles = HarpoClaims.SiteAdminRole)]
@rendermode InteractiveServer
@using Harpo.Replication
@using Microsoft.Extensions.Options
@inject ReplicationEngine Engine
@inject ReplicationStatusTracker Tracker
@inject IOptions<ReplicationOptions> ReplicationConfig
@inject IOptions<Harpo.Offline.OfflineOptions> OfflineConfig
@inject GroupService Groups
@inject AuditService Audit
@inject IconService Icons
@inject Harpo.Security.CryptoService Crypto
@inject VaultService Vault
@inject PurgeService Purge
@inject Harpo.Data.DbEncryptionStatus DbFile
@implements IDisposable

<PageTitle>Administration · Harpo</PageTitle>
<SessionWatch />

<div class="page-narrow">
    <h1>Administration</h1>

    <nav class="section-nav" aria-label="Sections of this page">
        <a href="/admin#site">This site</a>
        <a href="/admin#replication">Replication</a>
        <a href="/admin#audit">Audit log</a>
        <a href="/admin#icons">Icons</a>
        <a href="/admin#groups">Groups</a>
        <a href="/admin#export">Export</a>
    </nav>

    <section class="panel" id="site">
        <h2>This site</h2>
        <div class="stat-row">
            <div class="stat">
                <span class="stat-value mono">@Engine.SiteId</span>
                <span class="stat-label">site id</span>
            </div>
            <div class="stat">
                <span class="stat-value">@(_status?.Groups.ToString() ?? "…")</span>
                <span class="stat-label">groups</span>
            </div>
            <div class="stat">
                <span class="stat-value">@(_status?.Entries.ToString() ?? "…")</span>
                <span class="stat-label">passwords</span>
            </div>
            <div class="stat" title="Read from the file when Harpo started. Set Harpo__DatabaseKey to encrypt the whole file, including entry names, URLs, usernames, group membership and the audit log.">
                <span class="stat-value">@(DbFile.IsEncrypted switch { true => "Encrypted", false => "Not encrypted", null => "Unknown" })</span>
                <span class="stat-label">
                    @(DbFile.IsEncrypted == false ? "database file · passwords are still encrypted" : "database file")
                </span>
            </div>
            <div class="stat" title="Set Harpo__Offline__Enabled=false to forbid offline password storage on devices.">
                <span class="stat-value">@(OfflineConfig.Value.Enabled ? "Allowed" : "Off")</span>
                <span class="stat-label">
                    @(OfflineConfig.Value.Enabled
                        ? $"offline copies · expire after {OfflineConfig.Value.SnapshotMaxAgeDays} days"
                        : "offline copies")
                </span>
            </div>
        </div>
        @if (Crypto.HasPreviousKeys)
        {
            <div class="alert alert-warning gap-top">
                <strong>Master key rotation in progress</strong> — @Crypto.PreviousKeyCount previous
                key@(Crypto.PreviousKeyCount == 1 ? "" : "s") configured. Local data has been re-encrypted
                under the active key. Once every replicated site runs the new key and replication has
                caught up, remove <code>Harpo__PreviousMasterKeys</code> and restart.
            </div>
        }
    </section>

    <section class="panel" id="replication">
        <h2>Cross-site replication</h2>
        @if (!ReplicationConfig.Value.Enabled)
        {
            <p class="muted">
                Replication is disabled — set <span class="mono">Replication:Key</span> and
                <span class="mono">Replication:Peers</span> to connect this site to others.
            </p>
        }
        else if (ReplicationConfig.Value.Peers.Count == 0)
        {
            <p class="muted">
                A replication key is set, so other sites can pull from this one, but this
                site has no peers of its own configured.
            </p>
        }
        else
        {
            <div class="table-scroll">
                <table class="peers-table">
                    <thead>
                        <tr><th>Peer</th><th>URL</th><th>Last sync</th><th>Rows pulled</th><th>Clock skew</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var peer in PeerStatuses)
                        {
                            <tr>
                                <td class="mono">@peer.Name</td>
                                <td class="mono muted">@peer.Url</td>
                                <td title="@(peer.LastSuccessUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")">
                                    @(peer.LastSuccessUtc is null ? "never" : Relative(peer.LastSuccessUtc.Value))
                                </td>
                                <td>@peer.TotalPulledRows</td>
                                <td>
                                    @if (peer.ClockSkew is { } skew)
                                    {
                                        var abs = skew.Duration();
                                        if (abs > TimeSpan.FromSeconds(30))
                                        {
                                            <span class="badge badge-error"
                                                  title="Clocks differ by @abs — last-writer-wins conflict resolution needs NTP-synced sites.">
                                                @FormatSkew(abs) drift
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="mono muted">@FormatSkew(abs)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (peer.LastError is not null)
                                    {
                                        <span class="badge badge-error" title="@peer.LastError">error</span>
                                    }
                                    else if (peer.LastSuccessUtc is not null)
                                    {
                                        <span class="badge badge-ok">healthy</span>
                                    }
                                    else
                                    {
                                        <span class="badge">waiting</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_status is not null && _status.Vector.Count > 0)
        {
            <h3>High-watermark vector</h3>
            <p class="muted">
                Highest change sequence this site has seen from each origin — replication
                is caught up when peers report the same numbers.
            </p>
            <div class="vector">
                @foreach (var (site, seq) in _status.Vector.OrderBy(kv => kv.Key, StringComparer.Ordinal))
                {
                    <span class="vector-chip mono">@site → @seq</span>
                }
            </div>
        }
    </section>

    <section class="panel" id="audit">
        <h2>Audit log</h2>
        <p class="muted">
            Who revealed, copied, or deleted what — recorded
            @(Audit.Enabled ? "on this site" : "on other sites only") and replicated everywhere.
            @if (!Audit.Enabled)
            {
                <span class="badge badge-error" title="Set Harpo__Audit__Enabled=true to record events on this site.">recording off</span>
            }
            else
            {
                <span class="badge badge-ok" title="Set Harpo__Audit__Enabled=false to stop recording on this site.">recording on</span>
                <span class="badge">@(Audit.RetentionDays > 0 ? $"kept {Audit.RetentionDays}d" : "kept forever")</span>
            }
        </p>

        <div class="audit-controls">
            <div class="filter-chips" role="group" aria-label="Show">
                @foreach (var (category, label, hint) in AuditCategoryChips)
                {
                    <button type="button" class="chip @(category == _auditCategory ? "selected" : "")"
                            aria-pressed="@(category == _auditCategory ? "true" : "false")" title="@hint"
                            @onclick="() => SetAuditCategoryAsync(category)">@label</button>
                }
            </div>
            <input class="search" type="search" placeholder="Filter by user, action, or target…"
                   aria-label="Filter the events shown" @bind="_auditFilter" @bind:event="oninput"
                   @bind:after="OnAuditFilterTypedAsync" />
        </div>

        @if (_auditEvents is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_auditEvents.Count == 0)
        {
            <p class="muted">
                @(_auditFilter.Trim().Length > 0 ? "No events match."
                    : _auditCategory == AuditCategory.All ? "No audit events yet." : "No events of this kind.")
            </p>
        }
        else
        {
            <div class="table-scroll">
                <table class="audit-table">
                    <thead>
                        <tr><th>When</th><th>Who</th><th>Action</th><th>What</th><th>Site</th><th>From</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in AuditRows)
                        {
                            var e = row.Latest;
                            <tr class="@(AuditActions.CategoryOf(e.Action) == AuditCategory.Background ? "audit-background" : "")">
                                <td title="@AuditWhenTitle(row)">
                                    @Relative(e.OccurredAtUtc)
                                    @if (row.Count > 1)
                                    {
                                        <span class="badge audit-repeat">×@row.Count</span>
                                    }
                                </td>
                                <td class="mono">@e.Username</td>
                                <td><span class="badge @AuditBadgeClass(e.Action)">@e.Action</span></td>
                                <td>
                                    @e.Target
                                    @if (!string.IsNullOrEmpty(e.Detail))
                                    {
                                        <span class="muted"> · @e.Detail</span>
                                    }
                                </td>
                                <td class="mono muted">@e.OriginSiteId</td>
                                <td class="mono muted">@e.ClientAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="_auditPage" PageSize="AuditPageSize" Total="_auditTotal" Label="Pages of audit events"
                   OnPage="GoToAuditPageAsync" ScrollTo="#audit" />
        }
    </section>

    <section class="panel" id="icons">
        <h2>Icon catalogue</h2>
        <p class="muted">
            Custom icons available for password entries. Deleting one leaves
            entries using it on the default glyph.
        </p>

        <div class="form-row icon-add-row">
            <label class="field">
                <span class="field-label">Image (≤64 KB)</span>
                <InputFile OnChange="StageIconAsync"
                           accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" />
            </label>
            <label class="field">
                <span class="field-label">Name</span>
                <input @bind="_newIconName" placeholder="e.g. GitLab" />
            </label>
            <label class="field field-grow">
                <span class="field-label">Matched URLs (optional)</span>
                <input class="mono" @bind="_newIconUrls" placeholder="e.g. gitlab.com, git.corp.io" />
            </label>
            <button class="btn btn-primary" disabled="@(_stagedIconData is null)" @onclick="AddIconAsync">Add icon</button>
        </div>
        @if (_iconError is not null)
        {
            <div class="alert alert-error">@_iconError</div>
        }
        @if (Icons.ImportPath.Length > 0)
        {
            <p class="muted small">
                    Server folder: <span class="mono">@Icons.ImportPath</span> — images placed
                    there are imported at startup (a hostname filename like
                    <span class="mono">gitlab.com.png</span> auto-attributes the icon).
                <button class="btn btn-ghost btn-sm" @onclick="ImportIconsAsync">Import now</button>
                @if (_importResult is not null)
                {
                    <span class="badge badge-ok">@_importResult</span>
                }
            </p>
        }
        @if (_icons is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_icons.Count == 0)
        {
            <p class="muted">The catalogue is empty — add an image above.</p>
        }
        else
        {
            var matching = FilteredIcons;
            var shown = Paging.Slice(matching, ref _iconPage, ListPageSize);
            @if (_icons.Count > ListPageSize || _iconFilter.Length > 0)
            {
                <input class="search list-filter icon-filter" type="search" placeholder="Find an icon by name or URL…"
                       aria-label="Filter the icons shown" @bind="_iconFilter" @bind:event="oninput" @bind:after="() => _iconPage = 1" />
            }
            @if (matching.Count == 0)
            {
                <p class="muted">No icons match.</p>
            }
            else
            {
            <div class="table-scroll">
                <table class="icons-table">
                    <thead><tr><th>Icon</th><th>Name</th><th>Matched URLs</th><th>Uploaded by</th><th>Size</th><th>Used by</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var icon in shown)
                        {
                            <tr>
                                <td><img class="entry-icon-img" src="/api/icons/@icon.Id" alt="🔐" /></td>
                                <td>
                                    <input class="icon-name-input"
                                           value="@(_iconNameEdits.GetValueOrDefault(icon.Id, icon.Name))"
                                           @onchange='e => _iconNameEdits[icon.Id] = e.Value?.ToString() ?? ""' />
                                </td>
                                <td>
                                    <input class="mono icon-urls-input"
                                           value="@(_iconUrlEdits.GetValueOrDefault(icon.Id, icon.MatchUrls))"
                                           placeholder="e.g. gitlab.com"
                                           title="Hostnames this icon represents — entries with matching URLs pick it up automatically."
                                           @onchange='e => _iconUrlEdits[icon.Id] = e.Value?.ToString() ?? ""' />
                                    @if (IconRowDirty(icon))
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => SaveIconAsync(icon)">Save</button>
                                    }
                                </td>
                                <td class="mono muted">@icon.CreatedBy</td>
                                <td class="muted">@($"{icon.SizeBytes / 1024.0:0.#} KB")</td>
                                <td>@(_iconUsage.GetValueOrDefault(icon.Id)) @(_iconUsage.GetValueOrDefault(icon.Id) == 1 ? "entry" : "entries")</td>
                                <td class="cell-actions">
                                    <button class="btn btn-icon" title="Delete from catalogue"
                                            @onclick="() => DeleteIconAsync(icon)"><Lucide Name="trash" Size="16" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            <Pager Page="_iconPage" PageSize="ListPageSize" Total="matching.Count" Label="Pages of icons"
                   OnPage="p => _iconPage = p" ScrollTo="#icons" />
        }
    </section>

    @* Anchor for the page navigation: the group sections start here, whichever of them are shown. *@
    <span id="groups" class="section-anchor"></span>
    @if (_adminlessGroups is { Count: > 0 })
    {
        <section class="panel">
            <h2>Groups without an admin</h2>
            <div class="alert alert-warning">
                Nobody can manage the membership of these groups. This happens when admins on two sites
                demote or remove each other while the sites are out of contact — each change was valid
                where it was made, and replication keeps both. Members keep their access; open the group
                and appoint an admin.
            </div>
            <div class="card-list">
                @foreach (var g in _adminlessGroups)
                {
                    <div class="card group-card">
                        <div class="group-card-main">
                            <span class="group-card-name">@g.Name</span>
                        </div>
                        <div class="group-card-meta">
                            <a class="btn btn-ghost btn-sm" href="/groups/@g.Id">Appoint an admin →</a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (_deletedGroups is { Count: > 0 })
    {
        <section class="panel">
            <h2>Deleted groups</h2>
            <p class="muted">
                @_deletedGroupsTotal deleted. Restoring a group brings back the passwords that were not deleted individually.
                Purging one erases it and every password in it for good, on every site.
            </p>
            @if (_purgedGroupMessage is not null)
            {
                <p class="purge-result" role="status">@_purgedGroupMessage</p>
            }
            <div class="card-list">
                @foreach (var g in _showAllDeletedGroups ? _deletedGroups : _deletedGroups.Take(DeletedGroupsShown))
                {
                    <div class="card group-card">
                        <div class="group-card-main">
                            <span class="group-card-name">@g.Name</span>
                            <span class="muted">deleted @Relative(g.UpdatedAtUtc)</span>
                        </div>
                        <div class="group-card-meta">
                            <button class="btn btn-ghost btn-sm" @onclick="() => RestoreGroupAsync(g)">Restore</button>
                            <button class="btn btn-ghost btn-sm btn-danger-text purge-group" @onclick="() => OpenPurgeGroup(g)">Purge…</button>
                        </div>
                    </div>
                }
            </div>
            @if (_deletedGroups.Count > DeletedGroupsShown)
            {
                <button class="btn btn-ghost btn-sm show-all" @onclick="() => _showAllDeletedGroups = !_showAllDeletedGroups">
                    @(_showAllDeletedGroups ? "Show fewer" : $"Show all {_deletedGroups.Count}")
                </button>
            }
            @if (_showAllDeletedGroups && _deletedGroups.Count < _deletedGroupsTotal)
            {
                <button class="btn btn-ghost btn-sm show-all" @onclick="LoadOlderDeletedGroupsAsync">
                    Show older (@(_deletedGroupsTotal - _deletedGroups.Count) more)
                </button>
            }
        </section>
    }

    <section class="panel" id="personal-vaults">
        <h2>Personal vaults</h2>
        <p class="muted">
            Everyone gets a personal vault the first time they open Harpo. Only its owner can
            see what is in it — you included. When someone leaves, <strong>take their vault
            over</strong>: it becomes an ordinary group with you as an admin, so company accounts
            they kept there are not lost. The owner keeps their membership (if they are still
            around, they see it happen), the takeover is recorded in the audit log, and their
            next visit gives them a fresh personal vault.
        </p>
        @if (_personalVaults is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_personalVaults.Count == 0)
        {
            <p class="muted">Nobody has opened their personal vault yet.</p>
        }
        else
        {
            var matching = FilteredPersonalVaults;
            var shown = Paging.Slice(matching, ref _personalPage, ListPageSize);
            @if (_personalVaults.Count > ListPageSize || _personalFilter.Length > 0)
            {
                <input class="search list-filter personal-vaults-filter" type="search" placeholder="Find a person by username or name…"
                       aria-label="Filter the personal vaults shown" @bind="_personalFilter" @bind:event="oninput" @bind:after="() => _personalPage = 1" />
            }
            @if (matching.Count == 0)
            {
                <p class="muted">Nobody matches.</p>
            }
            else
            {
            <div class="table-scroll">
                <table class="personal-vaults-table">
                    <thead><tr><th>Owner</th><th>Passwords</th><th>Since</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var vault in shown)
                        {
                            <tr>
                                <td>
                                    <span class="mono">@vault.Group.OwnerUsername</span>
                                    @if (vault.OwnerDisplayName != vault.Group.OwnerUsername)
                                    {
                                        <span class="muted"> · @vault.OwnerDisplayName</span>
                                    }
                                </td>
                                <td>@vault.EntryCount</td>
                                <td class="muted" title="@vault.Group.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC">@vault.Group.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="cell-actions">
                                    @if (IsMine(vault))
                                    {
                                        <span class="badge" title="Your own personal vault: only someone else can take it over, if you leave.">you</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => OpenTakeover(vault)">Take over…</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            <Pager Page="_personalPage" PageSize="ListPageSize" Total="matching.Count" Label="Pages of personal vaults"
                   OnPage="p => _personalPage = p" ScrollTo="#personal-vaults" />
        }
        @if (_takeoverError is not null && _takeover is null)
        {
            <div class="alert alert-error">@_takeoverError</div>
        }
    </section>

    <section class="panel" id="all-groups">
        <h2>All groups</h2>
        @if (_groups is null)
        {
            <p class="muted">Loading…</p>
        }
        else
        {
            var shared = _groups.Where(g => !g.Group.IsPersonal).ToList();
            var matching = FilteredGroups(shared);
            var shown = Paging.Slice(matching, ref _groupPage, GroupPageSize);
            @if (shared.Count > GroupPageSize || _groupFilter.Length > 0)
            {
                <input class="search list-filter all-groups-filter" type="search" placeholder="Find a group by name, description or creator…"
                       aria-label="Filter the groups shown" @bind="_groupFilter" @bind:event="oninput" @bind:after="() => _groupPage = 1" />
            }
            @if (shared.Count == 0)
            {
                <p class="muted">No groups yet.</p>
            }
            else if (matching.Count == 0)
            {
                <p class="muted">No groups match.</p>
            }
            <div class="card-list">
                @foreach (var g in shown)
                {
                    <a class="card group-card" href="/groups/@g.Group.Id">
                        <div class="group-card-main">
                            <span class="group-card-name">@g.Group.Name</span>
                            <span class="muted">created by @g.Group.CreatedBy</span>
                        </div>
                        <div class="group-card-meta">
                            <span>@g.MemberCount members</span>
                            <span>@g.EntryCount passwords</span>
                        </div>
                    </a>
                }
            </div>
            <Pager Page="_groupPage" PageSize="GroupPageSize" Total="matching.Count" Label="Pages of groups"
                   OnPage="p => _groupPage = p" ScrollTo="#all-groups" />
        }
    </section>

    <section class="panel" id="export">
        <h2>Export</h2>
        @if (Vault.AllGroupsExportEnabled)
        {
            <p class="muted">
                Download every shared group on this site as one archive: a file per group, each the same as
                that group's own export, so it imports back into a Harpo vault unchanged. The archive is
                <strong>not encrypted</strong> and is recorded in the audit log. Personal vaults are never
                included.
            </p>
            <button type="button" class="btn btn-ghost export-all-open" @onclick="() => _exportAllOpen = true">
                <Lucide Name="download" Size="16" /> Export all groups…
            </button>
        }
        else
        {
            <p class="muted export-all-off">
                Exporting all groups at once is off. To allow it, set
                <span class="mono">Harpo__Export__AllGroupsEnabled=true</span>@if (!Vault.ExportEnabled)
                {
                    <text> and </text><span class="mono">Harpo__Export__Enabled=true</span>
                }
                and restart — and read "Import and export" in the README first.
            </p>
        }
    </section>
</div>

@if (_exportAllOpen && Vault.AllGroupsExportEnabled)
{
    <ExportAllGroupsDialog User="_user!" OnClose="CloseExportAllAsync" />
}

<Modal Visible="_purgeGroup is not null" Title="Purge a deleted group" OnClose="ClosePurgeGroup" CloseOnBackdrop="false">
    @if (_purgeGroup is { } purging)
    {
        <div class="purge-confirm">
            <p>
                <strong>@purging.Name</strong> and every password in it — deleted or not — will be erased for good:
                their password history, notes and 2FA secrets, and the group's name and description. It
                disappears from every site and can never be restored.
            </p>
            <p class="alert alert-warning purge-warning">This cannot be undone.</p>
            @if (_purgeGroupError is not null)
            {
                <div class="alert alert-error" role="alert">@_purgeGroupError</div>
            }
            @if (_purgeGroupBusy)
            {
                <div class="busy-status" role="status">
                    <span class="spinner" aria-hidden="true"></span>
                    <span>Purging… <span class="muted">Erasing the group and rewriting this site's database file.</span></span>
                </div>
            }
            else
            {
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="ClosePurgeGroup">Cancel</button>
                    <button type="button" class="btn btn-danger purge-confirm-button" @onclick="PurgeGroupAsync">Purge group</button>
                </div>
            }
        </div>
    }
</Modal>

<Modal Visible="_takeover is not null" Title="Take over a personal vault" OnClose="() => _takeover = null">
    @if (_takeover is { } taking)
    {
        <form class="form-grid" novalidate @onsubmit="TakeOverAsync">
            <p class="muted">
                <span class="mono">@taking.Group.OwnerUsername</span>'s personal vault
                (@taking.EntryCount @(taking.EntryCount == 1 ? "password" : "passwords")) becomes an
                ordinary group that you administer. This cannot be undone, is recorded in the audit
                log, and is visible to its owner.
            </p>
            <label class="field">
                <span class="field-label">Name for the group</span>
                <input @bind="_takeoverName" />
            </label>
            @if (_takeoverError is not null)
            {
                <div class="alert alert-error" role="alert">@_takeoverError</div>
            }
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" @onclick="() => _takeover = null">Cancel</button>
                <button type="submit" class="btn btn-danger">Take over</button>
            </div>
        </form>
    }
</Modal>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool _exportAllOpen;

    private async Task CloseExportAllAsync()
    {
        _exportAllOpen = false;
        await LoadAuditAsync(); // a download just made shows up as site.export
    }

