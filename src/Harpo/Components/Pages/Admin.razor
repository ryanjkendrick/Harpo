    private const int ListPageSize = 25;
    private const int GroupPageSize = 20;
    private int _personalPage = 1;
    private int _iconPage = 1;
    private int _groupPage = 1;
    private string _personalFilter = "";
    private string _iconFilter = "";
    private string _groupFilter = "";

    private static bool Has(string? text, string term) =>
        text is not null && text.Contains(term, StringComparison.OrdinalIgnoreCase);

    private List<PersonalVaultSummary> FilteredPersonalVaults
    {
        get
        {
            var term = _personalFilter.Trim();
            return term.Length == 0 ? _personalVaults ?? []
                : (_personalVaults ?? []).Where(v => Has(v.Group.OwnerUsername, term) || Has(v.OwnerDisplayName, term)).ToList();
        }
    }

    private List<IconSummary> FilteredIcons
    {
        get
        {
            var term = _iconFilter.Trim();
            return term.Length == 0 ? _icons ?? []
                : (_icons ?? []).Where(i => Has(i.Name, term) || Has(i.MatchUrls, term)).ToList();
        }
    }

    private List<GroupSummary> FilteredGroups(List<GroupSummary> groups)
    {
        var term = _groupFilter.Trim();
        return term.Length == 0 ? groups
            : groups.Where(g => Has(g.Group.Name, term) || Has(g.Group.Description, term) || Has(g.Group.CreatedBy, term)).ToList();
    }

    private List<PersonalVaultSummary>? _personalVaults;
    private PersonalVaultSummary? _takeover;
    private string _takeoverName = "";
    private string? _takeoverError;

    private bool IsMine(PersonalVaultSummary vault) =>
        string.Equals(vault.Group.OwnerUsername, _user?.Username, StringComparison.OrdinalIgnoreCase);

    private void OpenTakeover(PersonalVaultSummary vault)
    {
        if (IsMine(vault))
        {
            return; // no button for it; and the service refuses it anyway
        }
        _takeover = vault;
        _takeoverName = $"{vault.Group.OwnerUsername}'s personal vault";
        _takeoverError = null;
    }

    private async Task TakeOverAsync()
    {
        if (_takeover is null)
        {
            return;
        }
        try
        {
            _takeoverError = null;
            await Groups.TakeOverPersonalVaultAsync(_user!, _takeover.Group.Id, _takeoverName);
            _takeover = null;
            _groups = await Groups.GetMyGroupsAsync(_user!);
            _personalVaults = await Groups.GetPersonalVaultsAsync(_user!);
            await LoadAuditAsync();
        }
        catch (Exception ex) when (ex is VaultValidationException or VaultAccessDeniedException or VaultNotFoundException)
        {
            _takeoverError = ex.Message;
        }
    }

