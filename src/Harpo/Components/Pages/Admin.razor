    private ReplicationStatusResponse? _status;
    private List<GroupSummary>? _groups;
    private List<AuditEvent>? _auditEvents;
    private List<Group>? _deletedGroups;
    private int _deletedGroupsTotal;
    private List<Group>? _adminlessGroups;
