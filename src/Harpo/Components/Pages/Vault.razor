@page "/"
@page "/vault/{GroupId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject GroupService Groups
@inject VaultService Passwords
@inject IconService IconCatalogue
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Vault · Harpo</PageTitle>

<div class="vault">
    <div class="vault-groups">
        <div class="vault-groups-header">
            <h2>Groups</h2>
            <a class="btn btn-ghost btn-sm" href="/groups" title="Manage groups">Manage</a>
        </div>
        @if (_groups is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_groups.Count == 0)
        {
            <p class="muted">You are not a member of any group yet.</p>
            <a class="btn btn-primary btn-sm" href="/groups">Create a group</a>
        }
        else
        {
            <ul class="group-list">
                @foreach (var g in _groups)
                {
                    <li>
                        <a class="group-item @(g.Group.Id == SelectedGroupId ? "selected" : "")"
                           href="/vault/@g.Group.Id">
                            <span class="group-item-name">@g.Group.Name</span>
                            <span class="group-item-meta">
                                @g.EntryCount @(g.EntryCount == 1 ? "password" : "passwords")
                                @if (g.MyRole == GroupRole.Admin)
                                {
                                    <span class="badge badge-admin" title="You administer this group">admin</span>
                                }
                                else if (g.MyRole is null)
                                {
                                    <span class="badge" title="Visible because you are a site admin">site admin</span>
                                }
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="vault-entries">
        @if (SelectedGroupId is null)
        {
            <div class="empty-state">
                <span class="empty-icon">🤫</span>
                <h2>Nothing to see here</h2>
                <p class="muted">Select a group on the left to browse its passwords.</p>
            </div>
        }
        else
        {
            <div class="vault-toolbar">
                <h1>@_selectedGroupName</h1>
                <input class="search" type="search" placeholder="Search name, URL, username…"
                       @bind="_search" @bind:event="oninput" />
                @if (CanEdit)
                {
                    <button class="btn btn-primary" @onclick="OpenNewEntry">＋ New password</button>
                }
                else
                {
                    <span class="badge" title="You have read-only access to this group">viewer</span>
                }
            </div>

            @if (_entries is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (FilteredEntries.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">🗝️</span>
                    <p class="muted">@(_entries.Count == 0 ? "No passwords in this group yet." : "Nothing matches your search.")</p>
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="entries-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Username</th>
                                <th>URL</th>
                                <th>Password</th>
                                <th>Last updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var view in FilteredEntries)
                            {
                                var entry = view.Entry;
                                <tr>
                                    <td class="cell-name" title="@entry.Notes">
                                        <EntryIcon Icon="@entry.Icon" />
                                        <span class="entry-name">@entry.Name</span>
                                    </td>
                                    <td class="cell-username">
                                        @if (!string.IsNullOrEmpty(entry.Username))
                                        {
                                            <span class="mono">@entry.Username</span>
                                            <button class="btn btn-icon" title="Copy username"
                                                    @onclick='() => CopyTextAsync(entry.Username, "Username copied")'><Lucide Name="copy" Size="15" /></button>
                                        }
                                    </td>
                                    <td class="cell-url">
                                        @if (!string.IsNullOrEmpty(entry.Url))
                                        {
                                            <a href="@entry.Url" target="_blank" rel="noopener noreferrer" title="@entry.Url">@DisplayUrl(entry.Url)</a>
                                        }
                                    </td>
                                    <td class="cell-password">
                                        @if (_revealed.TryGetValue(entry.Id, out var plain))
                                        {
                                            <code class="mono revealed">@plain</code>
                                            <button class="btn btn-icon" title="Hide" @onclick="() => Hide(entry.Id)"><Lucide Name="eye-off" Size="16" /></button>
                                        }
                                        else
                                        {
                                            <span class="mask">••••••••</span>
                                            <button class="btn btn-icon" title="Reveal" @onclick="() => RevealAsync(entry.Id)"><Lucide Name="eye" Size="16" /></button>
                                        }
                                        <button class="btn btn-icon" title="Copy password"
                                                @onclick="() => CopyPasswordAsync(entry.Id)"><Lucide Name="copy" Size="15" /></button>
                                        @if (entry.EncryptedTotpSecret is not null)
                                        {
                                            @if (_totp.TryGetValue(entry.Id, out var totp))
                                            {
                                                <span class="totp-code" title="Current 2FA code">
                                                    <code class="mono revealed">@FormatTotp(totp.Code)</code>
                                                    <span class="muted totp-remaining">@(totp.Remaining)s</span>
                                                </span>
                                                <button class="btn btn-icon" title="Copy 2FA code"
                                                        @onclick='() => CopyTextAsync(totp.Code, "2FA code copied")'><Lucide Name="copy" Size="15" /></button>
                                                <button class="btn btn-icon" title="Hide 2FA code" @onclick="() => HideTotp(entry.Id)"><Lucide Name="eye-off" Size="16" /></button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-icon totp-chip" title="Show 2FA code"
                                                        @onclick="() => ShowTotpAsync(entry.Id)"><Lucide Name="timer" Size="16" /></button>
                                            }
                                        }
                                    </td>
                                    <td class="cell-updated" title="@FullTime(view.PasswordUpdatedAtUtc)">
                                        <span class="mono">@view.PasswordUpdatedBy</span>
                                        @if (view.PasswordUpdatedAtUtc is not null)
                                        {
                                            <span class="muted"> · @Relative(view.PasswordUpdatedAtUtc.Value)</span>
                                        }
                                    </td>
                                    <td class="cell-actions">
                                        @if (CanEdit)
                                        {
                                            <button class="btn btn-icon" title="Edit" @onclick="() => OpenEditEntry(entry)"><Lucide Name="pencil" Size="16" /></button>
                                        }
                                        <button class="btn btn-icon" title="Password history" @onclick="() => OpenHistoryAsync(entry)"><Lucide Name="history" Size="16" /></button>
                                        @if (CanEdit)
                                        {
                                            <button class="btn btn-icon" title="Delete" @onclick="() => DeleteEntryAsync(entry)"><Lucide Name="trash" Size="16" /></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (CanEdit && _deletedEntries is { Count: > 0 })
            {
                <details class="trash">
                    <summary class="muted"><Lucide Name="trash" Size="14" /> Recently deleted (@_deletedEntries.Count)</summary>
                    <div class="table-scroll">
                        <table>
                            <tbody>
                                @foreach (var entry in _deletedEntries)
                                {
                                    <tr>
                                        <td class="cell-name">
                                            <EntryIcon Icon="@entry.Icon" />
                                            <span class="entry-name">@entry.Name</span>
                                        </td>
                                        <td class="muted">deleted by <span class="mono">@entry.UpdatedBy</span> · @Relative(entry.UpdatedAtUtc)</td>
                                        <td class="cell-actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="() => RestoreEntryAsync(entry)">Restore</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        }
    </div>
</div>

<Modal Visible="_editor is not null" Title="@(_editorIsNew ? "New password" : "Edit password")" OnClose="CloseEditor">
    @if (_editor is not null)
    {
        <div class="form-grid">
            <label class="field">
                <span class="field-label">Name</span>
                <input @bind="_editor.Name" placeholder="e.g. Corporate Twitter" />
            </label>
            <label class="field">
                <span class="field-label">Icon</span>
                <IconPicker Value="@_editor.Icon" ValueChanged="OnIconPicked" User="_user" SuggestedUrl="@_editor.Url" />
            </label>
            <label class="field">
                <span class="field-label">URL</span>
                <input @bind="_editor.Url" @bind:event="oninput" @bind:after="OnUrlChanged" placeholder="https://…" />
            </label>
            <label class="field">
                <span class="field-label">Username</span>
                <input @bind="_editor.Username" placeholder="Account this password belongs to" />
            </label>
            <label class="field">
                <span class="field-label">@(_editorIsNew ? "Password" : "New password (leave blank to keep current)")</span>
                <span class="password-row">
                    <input class="mono" @bind="_editor.Password" @bind:event="oninput" />
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="GeneratePassword"><Lucide Name="dice" Size="15" /> Generate</button>
                    <button type="button" class="btn btn-ghost btn-sm" title="Generator options"
                            @onclick="() => _showGenOptions = !_showGenOptions"><Lucide Name="sliders" Size="15" /></button>
                </span>
                @if (_editor.Password.Length > 0)
                {
                    <span>
                        <span class="badge @StrengthBadgeClass(PasswordStrength.Score(_editor.Password))">
                            @PasswordStrength.Label(PasswordStrength.Score(_editor.Password))
                        </span>
                    </span>
                }
            </label>
            @if (_showGenOptions)
            {
                <div class="gen-options">
                    <label class="gen-length">
                        Length
                        <input type="range" min="8" max="64" value="@_gen.Length"
                               @oninput='e => SetGenLength(e.Value?.ToString() ?? "20")' />
                        <span class="mono">@_gen.Length</span>
                    </label>
                    <label><input type="checkbox" checked="@_gen.Uppercase" @onchange="e => SetGenClass(0, e)" /> A–Z</label>
                    <label><input type="checkbox" checked="@_gen.Lowercase" @onchange="e => SetGenClass(1, e)" /> a–z</label>
                    <label><input type="checkbox" checked="@_gen.Digits" @onchange="e => SetGenClass(2, e)" /> 0–9</label>
                    <label><input type="checkbox" checked="@_gen.Symbols" @onchange="e => SetGenClass(3, e)" /> !@@#</label>
                    <label><input type="checkbox" checked="@_gen.ExcludeAmbiguous" @onchange="e => SetGenClass(4, e)" /> avoid 0/O, 1/l</label>
                </div>
            }
            <label class="field">
                <span class="field-label">2FA secret (TOTP) — optional</span>
                <input class="mono" @bind="_editor.Totp"
                       placeholder="base32 secret or otpauth:// URI" autocomplete="off" />
            </label>
            @if (!_editorIsNew && _editorHasTotp)
            {
                <label class="field checkbox-row">
                    <span class="muted small">
                        2FA is configured on this entry. Leave the field blank to keep it,
                        paste a new secret to replace it, or remove it:
                    </span>
                    <span><input type="checkbox" @bind="_editor.RemoveTotp" /> Remove 2FA</span>
                </label>
            }
            <label class="field">
                <span class="field-label">Notes</span>
                <textarea rows="2" @bind="_editor.Notes"></textarea>
            </label>
            @if (_editorError is not null)
            {
                <div class="alert alert-error">@_editorError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-ghost" @onclick="CloseEditor">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveEntryAsync">@(_editorIsNew ? "Create" : "Save")</button>
            </div>
        </div>
    }
</Modal>

<Modal Visible="_historyEntry is not null" Title="@($"History · {_historyEntry?.Name}")" OnClose="CloseHistory">
    @if (_history is not null)
    {
        <p class="muted history-caption">Every password this entry has ever had, newest first, with who set it.</p>
        <div class="table-scroll">
            <table class="history-table">
                <thead>
                    <tr><th>#</th><th>Set by</th><th>When</th><th>Password</th></tr>
                </thead>
                <tbody>
                    @{ var number = _history.Count; }
                    @foreach (var rev in _history)
                    {
                        var revisionId = rev.RevisionId;
                        <tr>
                            <td>
                                @number
                                @if (rev.IsCurrent)
                                {
                                    <span class="badge badge-current">current</span>
                                }
                            </td>
                            <td class="mono">@rev.CreatedBy</td>
                            <td title="@FullTime(rev.CreatedAtUtc)">@Relative(rev.CreatedAtUtc)</td>
                            <td class="cell-password">
                                @if (_revealedRevisions.TryGetValue(revisionId, out var plain))
                                {
                                    <code class="mono revealed">@plain</code>
                                    <button class="btn btn-icon" title="Hide" @onclick="() => _revealedRevisions.Remove(revisionId)"><Lucide Name="eye-off" Size="16" /></button>
                                }
                                else
                                {
                                    <span class="mask">••••••••</span>
                                    <button class="btn btn-icon" title="Reveal" @onclick="() => RevealRevisionAsync(revisionId)"><Lucide Name="eye" Size="16" /></button>
                                }
                            </td>
                        </tr>
                        number--;
                    }
                </tbody>
            </table>
        </div>
    }
</Modal>

@if (_toast is not null)
{
    <div class="toast @(_toastIsError ? "toast-error" : "")">@_toast</div>
}

@code {
    [Parameter] public Guid? GroupId { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private UserContext? _user;
    private List<GroupSummary>? _groups;
    private List<EntryView>? _entries;
    private List<PasswordEntry>? _deletedEntries;
    private string _selectedGroupName = "";
    private string _search = "";
    private readonly Dictionary<Guid, string> _revealed = new();
    private readonly Dictionary<Guid, CancellationTokenSource> _revealTimers = new();
    private readonly Dictionary<Guid, TotpDisplay> _totp = new();
    private System.Threading.Timer? _totpTimer;
    private bool _editorHasTotp;

    private sealed class TotpDisplay
    {
        public string Code = "";
        public int Remaining;
        public DateTimeOffset ShownAtUtc;
    }
    private const int RevealAutoHideSeconds = 30;
    private const int ClipboardClearMs = 60_000;

    private EntryEditModel? _editor;
    private List<IconSummary> _iconCatalogue = [];
    private bool _iconAutoSet;
    private bool _editorIsNew;
    private Guid _editorEntryId;
    private string? _editorError;

    private PasswordEntry? _historyEntry;
    private List<RevisionView>? _history;
    private readonly Dictionary<Guid, string> _revealedRevisions = new();

    private string? _toast;
    private bool _toastIsError;
    private CancellationTokenSource? _toastCts;

    private Guid? SelectedGroupId => GroupId ?? _groups?.FirstOrDefault()?.Group.Id;

    private GroupRole? SelectedRole =>
        _groups?.FirstOrDefault(g => g.Group.Id == SelectedGroupId)?.MyRole;

    private bool CanEdit =>
        _user?.IsSiteAdmin == true || (SelectedRole?.CanWrite() ?? false);

    private List<EntryView> FilteredEntries
    {
        get
        {
            if (_entries is null)
            {
                return new List<EntryView>();
            }
            var term = _search.Trim();
            if (term.Length == 0)
            {
                return _entries;
            }
            return _entries
                .Where(v => v.Entry.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                            || v.Entry.Url.Contains(term, StringComparison.OrdinalIgnoreCase)
                            || v.Entry.Username.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = UserContext.FromPrincipal((await AuthState).User);
        _groups = await Groups.GetMyGroupsAsync(_user);
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        if (_user is null || _groups is null)
        {
            return;
        }
        var groupId = SelectedGroupId;
        if (groupId is null)
        {
            _entries = null;
            return;
        }
        try
        {
            _selectedGroupName = _groups.FirstOrDefault(g => g.Group.Id == groupId)?.Group.Name ?? "";
            _entries = await Passwords.GetEntriesAsync(_user, groupId.Value);
            _deletedEntries = CanEdit ? await Passwords.GetDeletedEntriesAsync(_user, groupId.Value) : null;
            _revealed.Clear();
        }
        catch (Exception ex) when (ex is VaultAccessDeniedException or VaultNotFoundException)
        {
            _entries = new List<EntryView>();
            ShowToast(ex.Message, isError: true);
        }
    }

    // ---- reveal / copy ----

    private async Task RevealAsync(Guid entryId)
    {
        try
        {
            _revealed[entryId] = await Passwords.RevealPasswordAsync(_user!, entryId);
            ScheduleAutoHide(entryId, () => _revealed.Remove(entryId));
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
        }
    }

    private void Hide(Guid entryId)
    {
        _revealed.Remove(entryId);
        CancelAutoHide(entryId);
    }

    private void ScheduleAutoHide(Guid key, Action hide)
    {
        CancelAutoHide(key);
        var cts = new CancellationTokenSource();
        _revealTimers[key] = cts;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(RevealAutoHideSeconds), cts.Token);
                await InvokeAsync(() =>
                {
                    hide();
                    _revealTimers.Remove(key);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private void CancelAutoHide(Guid key)
    {
        if (_revealTimers.Remove(key, out var cts))
        {
            cts.Cancel();
            cts.Dispose();
        }
    }

    public void Dispose()
    {
        foreach (var cts in _revealTimers.Values)
        {
            cts.Cancel();
            cts.Dispose();
        }
        _revealTimers.Clear();
        _totpTimer?.Dispose();
        _toastCts?.Cancel();
    }

    private async Task CopyPasswordAsync(Guid entryId)
    {
        try
        {
            var plain = await Passwords.RevealPasswordAsync(_user!, entryId, RevealPurpose.Copy);
            var ok = await JS.InvokeAsync<bool>("harpoCopy", plain, ClipboardClearMs);
            ShowToast(ok ? "Password copied — clipboard clears in 60s"
                         : "Copy failed — your browser may require HTTPS for clipboard access.", isError: !ok);
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
        }
    }

    private async Task CopyTextAsync(string text, string message)
    {
        var ok = await JS.InvokeAsync<bool>("harpoCopy", text);
        ShowToast(ok ? message : "Copy failed — your browser may require HTTPS for clipboard access.", isError: !ok);
    }

    private async Task RevealRevisionAsync(Guid revisionId)
    {
        if (_historyEntry is null)
        {
            return;
        }
        try
        {
            _revealedRevisions[revisionId] = await Passwords.RevealRevisionAsync(_user!, _historyEntry.Id, revisionId);
            ScheduleAutoHide(revisionId, () => _revealedRevisions.Remove(revisionId));
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
        }
    }

    // ---- editor ----

    private void OpenNewEntry()
    {
        _editorIsNew = true;
        _editorError = null;
        _iconAutoSet = false;
        _editor = new EntryEditModel { Icon = "🔐" };
        _ = LoadIconCatalogueAsync();
    }

    private async Task LoadIconCatalogueAsync()
    {
        _iconCatalogue = await IconCatalogue.GetAllAsync();
    }

    /// <summary>URL typed → suggest the attributed icon (never overriding a manual choice).</summary>
    private void OnUrlChanged()
    {
        if (_editor is null)
        {
            return;
        }
        var match = IconUrlMatcher.FindBestMatch(_editor.Url, _iconCatalogue);
        if (match is not null && (_editor.Icon == "🔐" || _iconAutoSet))
        {
            _editor.Icon = match.Reference;
            _iconAutoSet = true;
        }
        else if (match is null && _iconAutoSet)
        {
            _editor.Icon = "🔐";
            _iconAutoSet = false;
        }
    }

    /// <summary>Icon picked → the choice is the user's now; an attributed icon also fills an empty URL.</summary>
    private void OnIconPicked(string icon)
    {
        if (_editor is null)
        {
            return;
        }
        _editor.Icon = icon;
        _iconAutoSet = false;
        if (string.IsNullOrWhiteSpace(_editor.Url)
            && CustomIcon.ParseReference(icon) is { } id
            && _iconCatalogue.FirstOrDefault(i => i.Id == id) is { MatchUrls.Length: > 0 } summary)
        {
            _editor.Url = "https://" + summary.MatchUrls.Split(' ')[0];
        }
    }

    private void OpenEditEntry(PasswordEntry entry)
    {
        _editorIsNew = false;
        _editorEntryId = entry.Id;
        _editorError = null;
        _iconAutoSet = false;
        _editorHasTotp = entry.EncryptedTotpSecret is not null;
        _ = LoadIconCatalogueAsync();
        _editor = new EntryEditModel
        {
            Name = entry.Name,
            Icon = string.IsNullOrEmpty(entry.Icon) ? "🔐" : entry.Icon,
            Url = entry.Url,
            Username = entry.Username,
            Notes = entry.Notes,
        };
    }

    private void CloseEditor() => _editor = null;

    private void GeneratePassword()
    {
        if (_editor is not null)
        {
            _editor.Password = PasswordGenerator.Generate(_gen);
        }
    }

    // ---- generator preferences (persisted per browser in localStorage) ----

    private const string GenPrefsKey = "harpo.generator";
    private PasswordGeneratorOptions _gen = new();
    private bool _showGenOptions;
    private bool _genPrefsLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_genPrefsLoaded)
        {
            _genPrefsLoaded = true;
            try
            {
                var json = await JS.InvokeAsync<string?>("harpoPrefsGet", GenPrefsKey);
                if (!string.IsNullOrEmpty(json))
                {
                    _gen = System.Text.Json.JsonSerializer.Deserialize<PasswordGeneratorOptions>(json) ?? _gen;
                }
            }
            catch
            {
                // Corrupt or unavailable preferences never break the editor.
            }
        }
    }

    private void SetGenLength(string raw)
    {
        if (int.TryParse(raw, out var length))
        {
            _gen = _gen with { Length = Math.Clamp(length, 8, 64) };
            _ = SaveGenPrefsAsync();
        }
    }

    private void SetGenClass(int which, ChangeEventArgs e)
    {
        var value = e.Value is bool b && b;
        var updated = which switch
        {
            0 => _gen with { Uppercase = value },
            1 => _gen with { Lowercase = value },
            2 => _gen with { Digits = value },
            3 => _gen with { Symbols = value },
            _ => _gen with { ExcludeAmbiguous = value },
        };
        // Keep at least one character class enabled.
        if (updated is { Uppercase: false, Lowercase: false, Digits: false, Symbols: false })
        {
            return;
        }
        _gen = updated;
        _ = SaveGenPrefsAsync();
    }

    private async Task SaveGenPrefsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("harpoPrefsSet", GenPrefsKey, System.Text.Json.JsonSerializer.Serialize(_gen));
        }
        catch
        {
        }
    }

    private static string StrengthBadgeClass(int score) => score switch
    {
        <= 1 => "badge-error",
        2 => "",
        _ => "badge-ok",
    };

    private async Task SaveEntryAsync()
    {
        if (_editor is null || SelectedGroupId is null)
        {
            return;
        }
        try
        {
            if (_editorIsNew)
            {
                await Passwords.CreateEntryAsync(_user!, SelectedGroupId.Value,
                    _editor.Name, _editor.Icon, _editor.Url, _editor.Username, _editor.Notes, _editor.Password,
                    _editor.Totp);
                ShowToast("Password created");
            }
            else
            {
                await Passwords.UpdateEntryAsync(_user!, _editorEntryId,
                    _editor.Name, _editor.Icon, _editor.Url, _editor.Username, _editor.Notes,
                    _editor.Totp, _editor.RemoveTotp);
                if (_editor.Password.Length > 0)
                {
                    await Passwords.ChangePasswordAsync(_user!, _editorEntryId, _editor.Password);
                }
                ShowToast("Saved");
            }
            _editor = null;
            await ReloadAsync();
        }
        catch (VaultValidationException ex)
        {
            _editorError = ex.Message;
        }
        catch (Exception ex) when (ex is VaultAccessDeniedException or VaultNotFoundException)
        {
            _editorError = ex.Message;
        }
    }

    private async Task RestoreEntryAsync(PasswordEntry entry)
    {
        try
        {
            await Passwords.RestoreEntryAsync(_user!, entry.Id);
            ShowToast($"\"{entry.Name}\" restored");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
        }
    }

    private async Task DeleteEntryAsync(PasswordEntry entry)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete \"{entry.Name}\"? Its history is kept, but it disappears from the vault on every site.");
        if (!confirmed)
        {
            return;
        }
        try
        {
            await Passwords.DeleteEntryAsync(_user!, entry.Id);
            ShowToast("Deleted");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
        }
    }

    // ---- history ----

    private async Task OpenHistoryAsync(PasswordEntry entry)
    {
        _historyEntry = entry;
        _history = null;
        _revealedRevisions.Clear();
        try
        {
            _history = await Passwords.GetHistoryAsync(_user!, entry.Id);
        }
        catch (Exception ex)
        {
            _historyEntry = null;
            ShowToast(ex.Message, isError: true);
        }
    }

    private void CloseHistory()
    {
        _historyEntry = null;
        _history = null;
        _revealedRevisions.Clear();
    }

    // ---- helpers ----

    private async Task ReloadAsync()
    {
        _groups = await Groups.GetMyGroupsAsync(_user!);
        await LoadEntriesAsync();
    }

    private void ShowToast(string message, bool isError = false)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        _toast = message;
        _toastIsError = isError;
        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3000, token);
                await InvokeAsync(() =>
                {
                    _toast = null;
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private static string DisplayUrl(string url)
    {
        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return uri.Host;
        }
        return url.Length > 30 ? url[..30] + "…" : url;
    }

    private static string FullTime(DateTime? utc) =>
        utc is null ? "" : $"{utc:yyyy-MM-dd HH:mm:ss} UTC";

    private static string Relative(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        return span.TotalSeconds < 90 ? "just now"
            : span.TotalMinutes < 90 ? $"{Math.Round(span.TotalMinutes)}m ago"
            : span.TotalHours < 36 ? $"{Math.Round(span.TotalHours)}h ago"
            : $"{Math.Round(span.TotalDays)}d ago";
    }

    public sealed class EntryEditModel
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "🔐";
        public string Url { get; set; } = "";
        public string Username { get; set; } = "";
        public string Notes { get; set; } = "";
        public string Password { get; set; } = "";
        public string Totp { get; set; } = "";
        public bool RemoveTotp { get; set; }
    }

    // ---- TOTP display: tick every second, refetch at rollover, close after 2 minutes ----

    private async Task ShowTotpAsync(Guid entryId)
    {
        await FetchTotpAsync(entryId, markShown: true);
        _totpTimer ??= new System.Threading.Timer(_ => _ = OnTotpTickAsync(), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void HideTotp(Guid entryId)
    {
        _totp.Remove(entryId);
        if (_totp.Count == 0)
        {
            _totpTimer?.Dispose();
            _totpTimer = null;
        }
    }

    private async Task FetchTotpAsync(Guid entryId, bool markShown)
    {
        try
        {
            var code = await Passwords.GetTotpCodeAsync(_user!, entryId);
            var shownAt = markShown || !_totp.TryGetValue(entryId, out var existing)
                ? DateTimeOffset.UtcNow
                : existing.ShownAtUtc;
            _totp[entryId] = new TotpDisplay { Code = code.Code, Remaining = code.SecondsRemaining, ShownAtUtc = shownAt };
        }
        catch (Exception ex)
        {
            _totp.Remove(entryId);
            ShowToast(ex.Message, isError: true);
        }
    }

    private async Task OnTotpTickAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                var now = DateTimeOffset.UtcNow;
                foreach (var (entryId, display) in _totp.ToList())
                {
                    if (now - display.ShownAtUtc > TimeSpan.FromMinutes(2))
                    {
                        HideTotp(entryId); // reveal hygiene: don't stay open forever
                        continue;
                    }
                    display.Remaining--;
                    if (display.Remaining <= 0)
                    {
                        await FetchTotpAsync(entryId, markShown: false);
                    }
                }
                if (_totp.Count == 0)
                {
                    _totpTimer?.Dispose();
                    _totpTimer = null;
                }
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private static string FormatTotp(string code) =>
        code.Length == 6 ? $"{code[..3]} {code[3..]}" : $"{code[..(code.Length / 2)]} {code[(code.Length / 2)..]}";
}
