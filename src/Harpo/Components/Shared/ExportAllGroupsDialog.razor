@* Export every shared group of the site as one archive (site administrators).
   The download itself is a plain link to the all-groups endpoint, which checks
   the session, the role, both export switches and its own rate limit, and
   records the export in the audit log — exactly as ExportDialog does for one
   vault. The counts are read without decrypting anything. *@
@inject VaultService Vault

<Modal Visible="true" Title="Export all groups" OnClose="CloseAsync">
    <div class="alert alert-warning export-warning" role="note">
        <strong>The archive is not encrypted.</strong>
        It holds every shared password on this site in plain text — every group's current passwords,
        2FA secrets and notes. Anyone who gets hold of it can read all of them.
    </div>
    <ul class="export-facts">
        <li>The export is recorded in the audit log under your name.</li>
        <li>Delete the archive and every file taken out of it, and empty your computer's recycle bin, as soon as you have used it.</li>
        <li>Personal vaults are not included — not even yours; export that from your vault. Deleted groups and
            deleted passwords are left out, and only current passwords are exported.</li>
    </ul>
    <div class="export-all-count" role="status">
        @if (_error is not null)
        {
            <span class="alert alert-error">@_error</span>
        }
        else if (_summary is null)
        {
            <span class="muted">Counting…</span>
        }
        else
        {
            <span>The archive will hold <strong class="export-all-groups">@Plural(_summary.Groups, "group", "groups")</strong>
                with <strong class="export-all-entries">@Plural(_summary.Entries, "password", "passwords")</strong>,
                one file per group (a group with no passwords gets an empty file), and a README.txt.</span>
        }
    </div>
    <fieldset class="export-formats">
        <legend class="field-label">Format of each group's file</legend>
        <label class="export-format">
            <input type="radio" name="export-all-format" value="csv" checked="@(_format == ExportFormat.Csv)"
                   @onchange="() => _format = ExportFormat.Csv" />
            <span><strong>CSV</strong> — the same file as each group's own CSV export, under Bitwarden's column
                names; most password managers (and Harpo) can import it.</span>
        </label>
        <label class="export-format">
            <input type="radio" name="export-all-format" value="json" checked="@(_format == ExportFormat.Json)"
                   @onchange="() => _format = ExportFormat.Json" />
            <span><strong>JSON</strong> — Harpo's own format, icons included. For moving the groups into another
                Harpo site.</span>
        </label>
    </fieldset>
    <div class="modal-footer">
        @if (_started)
        {
            <p class="muted small export-started" role="status">
                The download should start now. One archive a minute; delete it once you have used it.
            </p>
        }
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" @onclick="CloseAsync">@(_started ? "Close" : "Cancel")</button>
            @* A real link, so the browser saves the file itself; "download" keeps Blazor's router out of it. *@
            <a class="btn btn-primary export-download" href="@ExportEndpoints.AllGroupsUrlFor(_format)" download
               @onclick="() => _started = true"><Lucide Name="download" Size="16" /> Download archive (@(_format == ExportFormat.Csv ? "CSV" : "JSON"))</a>
        </div>
    </div>
</Modal>

@code {
    [Parameter, EditorRequired] public UserContext User { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private ExportFormat _format = ExportFormat.Csv;
    private bool _started;
    private AllGroupsSummary? _summary;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Vault.GetAllGroupsExportSummaryAsync(User);
        }
        catch (Exception ex) when (ex is VaultAccessDeniedException or VaultNotFoundException)
        {
            _error = ex.Message;
        }
    }

    private static string Plural(int n, string one, string many) => $"{n} {(n == 1 ? one : many)}";

    private Task CloseAsync() => OnClose.InvokeAsync();
}
