@* Icon picker: emoji presets, the org's custom icon catalogue, free emoji entry,
   and an inline upload that adds straight to the catalogue. *@
@inject IconService Icons

<div class="icon-picker" role="group" aria-label="Icons">
    @foreach (var icon in Presets)
    {
        <button type="button"
                class="icon-option @(icon == Value ? "selected" : "")"
                aria-pressed="@(icon == Value ? "true" : "false")"
                @onclick="() => SelectAsync(icon)">@icon</button>
    }
    @if (_catalogue is not null)
    {
        @foreach (var icon in _catalogue)
        {
            <button type="button"
                    class="icon-option @(icon.Reference == Value ? "selected" : "")"
                    title="@(icon.MatchUrls.Length == 0 ? icon.Name : $"{icon.Name} · {icon.MatchUrls}")"
                    aria-label="@icon.Name"
                    aria-pressed="@(icon.Reference == Value ? "true" : "false")"
                    @onclick="() => SelectAsync(icon.Reference)">
                <img class="entry-icon-img" src="/api/icons/@icon.Id" alt="" />
            </button>
        }
    }
    @if (User is not null)
    {
        @* The file input stays focusable (visually hidden, not display:none) so the
           upload is reachable by keyboard; the label is its visible face. *@
        <label class="icon-upload">
            <Lucide Name="upload" Size="14" /> Upload
            <InputFile class="visually-hidden" OnChange="UploadAsync"
                       accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" />
        </label>
    }
</div>
<div class="icon-picker-extra">
    <label class="icon-free-label">
        <span>Or type any emoji</span>
        <input class="icon-free" maxlength="4"
               value="@(Value.StartsWith(CustomIcon.ReferencePrefix) ? "" : Value)"
               @onchange='e => SelectAsync(e.Value?.ToString() ?? "")' />
    </label>
    @if (User is not null)
    {
        <span class="muted small">
            Uploaded images (up to @(CustomIcon.MaxBytes / 1024) KB) join the icon catalogue shared by everyone on this Harpo.
        </span>
    }
</div>
@if (_uploadError is not null)
{
    <div class="alert alert-error" role="alert">@_uploadError</div>
}

@code {
    private static readonly string[] Presets =
    {
        "🔐", "🌐", "🖥️", "🗄️", "☁️", "📧", "💳", "🏦", "📱", "💬", "🛠️", "📦", "🧪", "📊", "🎫", "🔑",
    };

    [Parameter] public string Value { get; set; } = "🔐";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Enables uploading when the host page provides the caller's identity.</summary>
    [Parameter] public UserContext? User { get; set; }

    /// <summary>The entry's URL field, if any — uploads get attributed to its host automatically.</summary>
    [Parameter] public string? SuggestedUrl { get; set; }

    private List<IconSummary>? _catalogue;
    private string? _uploadError;

    protected override async Task OnInitializedAsync() =>
        _catalogue = await Icons.GetAllAsync();

    private async Task SelectAsync(string icon)
    {
        Value = string.IsNullOrWhiteSpace(icon) ? "🔐" : icon.Trim();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        if (User is null)
        {
            return;
        }
        try
        {
            var file = e.File;
            if (file.Size > CustomIcon.MaxBytes)
            {
                _uploadError = $"Icons are capped at {CustomIcon.MaxBytes / 1024} KB — resize the image first.";
                return;
            }
            await using var stream = file.OpenReadStream(CustomIcon.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var name = Path.GetFileNameWithoutExtension(file.Name);
            // If the entry already has a URL, attribute the new icon to its host
            // so future entries for the same site pick it up automatically.
            var icon = await Icons.AddAsync(User, name, file.ContentType, buffer.ToArray(),
                matchUrls: IconUrlMatcher.ExtractHost(SuggestedUrl) ?? "");
            _catalogue = await Icons.GetAllAsync();
            await SelectAsync(icon.Reference);
        }
        catch (VaultValidationException ex)
        {
            _uploadError = ex.Message;
        }
        catch (Exception)
        {
            _uploadError = "Upload failed — try a different image.";
        }
    }
}
